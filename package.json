{
  "name": "az-axi",
  "version": "0.1.2",
  "description": "Agent-facing Azure CLI AXI: compact TOON output over every az module.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/masyanru/az-axi.git"
  },
  "homepage": "https://github.com/masyanru/az-axi#readme",
  "bugs": {
    "url": "https://github.com/masyanru/az-axi/issues"
  },
  "type": "module",
  "bin": {
    "az-axi": "dist/bin/az-axi.js"
  },
  "files": [
    "dist",
    "skills/az-axi",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "build:skill": "tsx scripts/build-skill.ts",
    "skill:check": "tsx scripts/build-skill.ts --check",
    "dev": "tsx bin/az-axi.ts",
    "prepublishOnly": "npm run build && npm test && npm run skill:check",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "dependencies": {
    "@toon-format/toon": "^2.1.0",
    "axi-sdk-js": "^0.1.11",
    "gpt-tokenizer": "^3.4.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "keywords": [
    "azure",
    "az",
    "cli",
    "axi",
    "toon",
    "agent"
  ]
}
